[Unit]
Description=Podman  zabbix-mcp-server.service
BindsTo=zabbix.service
After=zabbix-agent.service

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=%E/state/environment
EnvironmentFile=-%E/state/smarthost.env
WorkingDirectory=%E/state
Restart=always
TimeoutStopSec=70
ExecStartPre=/bin/mkdir -p config
ExecStartPre=/bin/rm -f %t/zabbix-mcp-server.pid %t/zabbix-mcp-server.ctr-id
ExecStartPre=-runagent discover-smarthost
ExecStart=/usr/bin/podman run --conmon-pidfile %t/zabbix-mcp-server.pid \
    --cidfile %t/zabbix-mcp-server.ctr-id --cgroups=no-conmon \
    --pod-id-file %t/zabbix.pod-id --replace -d --name zabbix-mcp-server \
    --env ZBX_FRONTEND_URL=https://${TRAEFIK_HOST}/api_jsonrpc.php \
    --env PHP_TZ=${PHP_TZ} \
    --env-file=zabbix-mcp-server.env \
    ${ZABBIX_MCP_SERVER_IMAGE}
ExecStop=/usr/bin/podman stop --ignore --cidfile %t/zabbix-mcp-server.ctr-id -t 10
ExecReload=/usr/bin/podman kill -s HUP zabbix-mcp-server
SyslogIdentifier=%u
ExecStopPost=/usr/bin/podman rm --ignore -f --cidfile %t/zabbix-mcp-server.ctr-id
PIDFile=%t/zabbix-mcp-server.pid
Type=forking

[Install]
WantedBy=default.target
